    "terms": {
      "title": "Terms and conditions of use",
      "items": {
        "a": "Acceptance of terms. By accessing and using the Research Management System (SGI-FIIS), you agree to be bound by these terms and conditions in full. If you do not agree, you should refrain from using the system.",
        "b": "Platform use. SGI-FIIS is intended exclusively for the registration, review, approval, and tracking of scientific research projects, thesis plans, and academic reports of the Faculty of Computer Science and Systems Engineering of UNAS.",
        "c": "Account responsibility. Each user is responsible for maintaining the confidentiality of their access credentials and for all activities carried out under their account. Access credentials are personal and non-transferable."
      }
    },
    "privacy": {
      "title": "Privacy policy",
      "intro": "The Faculty of Computer Science and Systems Engineering (FIIS) of the National Agrarian University of the Jungle is committed to the protection and secure processing of data for all users of the SGI-FIIS platform. Below, we detail the formal basis for information collection and processing:",
      "items": {
        "a": "Data collected by the system. We collect basic identification information such as first and last names, National Identity Document (DNI), institutional email address (@unas.edu.pe), and encrypted access credentials. Additionally, we process academic progress information, research line assignments, thesis project records, and evaluation observations.",
        "b": "Purpose of data use. The information obtained is used exclusively for managing and validating research, automatically assigning evaluators based on specific research lines, controlling workflow, and sending automated notifications such as verification codes and password reset messages.",
        "c": "Recipients and access to information. Access is limited to authorized personnel according to the system's role-based access control (RBAC), including IT administrators, the FIIS Research Unit, dean's office, advisors, and assigned evaluators. Under no circumstances do we share or sell personal data to external entities.",
        "d": "Information security measures. User passwords are stored irreversibly using strong BCrypt hashing with random salt. Data transactions between the client and backend server are encrypted using HTTPS. Additionally, data storage is isolated from direct public networks.",
        "e": "ARCO rights and contact of the responsible party. Users have the right to access, rectify, cancel, or object to the processing of their information. For any privacy-related inquiry, you may contact the FIIS Research Unit directly at the institutional email address:"
      }
    },
    "copyright": {
      "title": "Copyright statement",
      "items": {
        "a": "Intellectual property of theses. Moral and intellectual copyright over the research projects and final works registered in SGI-FIIS belongs exclusively to the listed authors (students and graduates of UNAS), in accordance with current Peruvian legislation.",
        "b": "Academic use. The Faculty of Computer Science and Systems Engineering reserves the right to keep a digital copy of approved projects in its institutional repository solely for scientific dissemination and academic consultation without profit."
      }
    },
    "cookies": {
      "title": "Cookie policy",
      "items": {
        "a": "Use of storage technologies. The SGI-FIIS platform uses session cookies and browser storage (localStorage) to keep the user's session active securely once successful authentication is completed using JWT tokens.",
        "b": "Required technical cookies. We do not use cookies for commercial tracking or targeted advertising. All cookies and locally stored data are strictly technical and necessary to ensure the proper authorization and security flow of the system."
      }
    },
    "changes": {
      "title": "Legal change summary",
      "items": {
        "a": "Version 1.0 (July 2026). The first official version of the regulatory framework and data protection policies for the SGI-FIIS platform at UNAS is published. The authentication flow using academic roles is defined and the contact channels of the Faculty Research Unit are integrated."
      }
    },
    "events": {
      "title": "Event terms and conditions",
      "items": {
        "a": "Scientific event participation. The terms in this section apply to talks, conferences, and webinars organized by FIIS research groups through the system. Participants accept that the educational material presented is for academic use."
      }
    },
    "contact": {
      "email": "sgifiisunas@gmail.com"
    }
